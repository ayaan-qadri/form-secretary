{
  "name": "form-secretary",
  "version": "1.0.0",
  "description": "Smart cross-browser autofill extension for web forms",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "generate:icons": "node scripts/generate_icons.js",
    "test": "node --import tsx --test test/*.test.js"
  },
  "keywords": [
    "browser-extension",
    "autofill",
    "forms",
    "productivity",
    "wxt",
    "typescript"
  ],
  "author": "Ayaan Qadri",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayaan-qadri/form-secretary.git"
  },
  "bugs": {
    "url": "https://github.com/ayaan-qadri/form-secretary/issues"
  },
  "homepage": "https://github.com/ayaan-qadri/form-secretary#readme",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "lucide": "^1.31.0"
  }
}
